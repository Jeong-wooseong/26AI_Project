# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채워주세요.
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.

# ① OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급, sk- 로 시작)
OPENAI_API_KEY=sk-...

# ② MySQL 접속 정보 (docker compose 로 띄웠다면 그대로 두면 됩니다)
DB_URL=jdbc:mysql://localhost:3306/replyboss?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=replyboss
DB_PASSWORD=replyboss

# ③ 필요할 때만 바꾸세요 (앞의 # 을 지우면 적용)
# OPENAI_CLASSIFY_MODEL=gpt-6-luna
# OPENAI_GENERATE_MODEL=gpt-6.1-sol
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_REASONING_EFFORT=low
