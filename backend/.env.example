# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채워주세요.
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.

# ① OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급, sk- 로 시작)
OPENAI_API_KEY=sk-...

# ② MySQL 접속 정보 (docker compose 로 띄웠다면 그대로 두면 됩니다)
DB_URL=jdbc:mysql://localhost:3306/replyboss?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=replyboss
DB_PASSWORD=replyboss

# ③ 필요할 때만 바꾸세요 (앞의 # 을 지우면 적용)
# OPENAI_CLASSIFY_MODEL=gpt-6-luna
# OPENAI_GENERATE_MODEL=gpt-6.1-sol
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   (중복 답글 방지용 임베딩)
# OPENAI_REASONING_EFFORT=low
# OPENAI_CLASSIFY_REASONING_EFFORT=low   (분류 전용, 기본 low)

# ④ 메일 발송 (회원가입 이메일 인증, 비밀번호 재설정, 문의 답변 알림) — 필수
#    Gmail: Google 계정 > 보안 > 2단계 인증을 켠 뒤 '앱 비밀번호'(16자리)를 만들어 MAIL_PASSWORD 에 넣으세요.
#    계정 비밀번호를 그대로 넣으면 로그인되지 않고, 보안상으로도 앱 비밀번호를 써야 합니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=
# 보내는 사람 표시 (비우면 MAIL_USERNAME)
# MAIL_FROM=your-account@gmail.com

# ⑤ 계정 관련 (필요할 때만 바꾸세요)
# 메일 링크가 열 프론트엔드 주소
# APP_URL=http://localhost:5173
# '로그인 상태 유지' 쿠키 서명 키: 아무 긴 문자열 (비우면 개발용 기본값, 실제 서비스에서는 꼭 설정)
# REMEMBER_ME_KEY=
# 관리자로 만들 이메일 (첫 가입자는 자동으로 관리자)
# ADMIN_EMAILS=
